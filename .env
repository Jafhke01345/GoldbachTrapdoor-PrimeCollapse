# =============================================================================
# PRIMECOLLAPSE (GOLDBACH TRAPDOOR) CONFIGURATION
# =============================================================================

# Computational Backend Mode: [classical | quantum_simulation]
HERETIC_MEMORY_BACKEND="classical"

# Toggle whether verification checksum anomalies trigger strict system crash dumps
STABILITY_MODE=true

# =============================================================================
# CLASSICAL ALGEBRAIC FIELD CONFIGURATION
# =============================================================================

# The secure prime bit-length used for cryptographically secure random boundaries
# Options: 512, 1024, 2048 (Higher bits exponentially explode the anonymity set)
SECRET_BOUNDARY_BIT_LENGTH=1024

# The global prime modulus field identifier used for the multiplicative inverse trapdoor
# This value must strictly remain larger than the maximum possible sum of your boundaries
GLOBAL_FIELD_MODULUS_PRIME=7919

# =============================================================================
# LOCAL DEVELOPMENT &blueprints PIPELINE CONFIGURATION
# =============================================================================

# Toggle automated verification reports to bypass manual write-approval constraints
MEMORY_WRITE_APPROVAL=false

# Local workspace path used by the agent to log architectural tracking blueprints
OBSIDIAN_VAULT_PATH="C:/Users/tripp/Documents/hermes"
