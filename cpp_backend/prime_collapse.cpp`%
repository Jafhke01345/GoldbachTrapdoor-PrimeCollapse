#include <iostream>
#include <vector>
#include <random>
#include <chrono>
#include <iomanip>

typedef unsigned __int128 uint128;
typedef unsigned long long uint64;

uint64 power(uint64 base, uint64 exp, uint64 mod) {
    uint64 res = 1;
    base %= mod;
    while (exp > 0) {
        if (exp % 2 == 1) res = (uint128)res * base % mod;
        base = (uint128)base * base % mod;
        exp /= 2;
    }
    return res;
}

uint64 modInverse(uint64 a, uint64 m) {
    uint64 m0 = m, t, q;
    long long x0 = 0, x1 = 1;
    if (m == 1) return 0;
    while (a > 1) {
        if (m == 0) break;
        q = a / m;
        t = m;
        m = a % m;
        a = t;
        t = x0;
        x0 = x1 - q * x0;
        x1 = t;
    }
    if (x1 < 0) x1 += m0;
    return x1;
}

bool miller_rabin(uint64 n, int k = 10) {
    if (n < 2) return false;
    if (n == 2 || n == 3) return true;
    if (n % 2 == 0) return false;
    uint64 d = n - 1;
    while (d % 2 == 0) d /= 2;
    static const std::vector<uint64> bases = {2, 3, 5, 7, 11, 13, 17, 19, 23};
    for (uint64 a : bases) {
        if (n <= a) break;
        uint64 x = power(a, d, n);
        if (x == 1 || x == n - 1) continue;
        bool composite = true;
        while (d != n - 1) {
            x = (uint128)x * x % n;
            d *= 2;
            if (x == n - 1) {
                composite = false;
                break;
            }
        }
        if (composite) return false;
    }
    return true;
}

uint64 generate_prime(uint64 min, uint64 max) {
    static std::mt19937_64 gen(std::chrono::steady_clock::now().time_since_epoch().count());
    std::uniform_int_distribution<uint64> dist(min, max);
    while (true) {
        uint64 p = dist(gen);
        if (miller_rabin(p)) return p;
    }
}

void run_protocol() {
    const uint64 BIT_LENGTH = 31; 
    uint64 p = generate_prime(1ULL << (BIT_LENGTH * 2 - 1), (1ULL << (BIT_LENGTH * 2)) - 1);
    uint64 a = generate_prime(1ULL << (BIT_LENGTH - 1), (1ULL << BIT_LENGTH) - 1);
    uint64 b = generate_prime(1ULL << (BIT_LENGTH - 1), (1ULL << BIT_LENGTH) - 1);
    if (a > b) std::swap(a, b);

    uint64 sum_key = a + b;
    uint64 public_c = sum_key / 2;
    static std::mt19937_64 gen(std::chrono::steady_clock::now().time_since_epoch().count());
    uint64 secret_r = (gen() % (p - 3)) + 2;

    uint64 inv_sum = modInverse(sum_key, p);
    uint64 k = (uint128)secret_r * inv_sum % p;

    uint64 blinded_A = (uint128)a * k % p;
    uint64 blinded_B = (uint128)b * k % p;

    uint64 v_sum = (blinded_A + blinded_B) % p;
    uint64 inv_r = modInverse(secret_r, p);
    uint64 v_med = (uint128)(2 * public_c % p) * k % p * inv_r % p;

    std::cout << \"Protocol Execution Cycle: SUCCESS\" << std::endl;
}

int main() {
    run_protocol();
    return 0;
}
