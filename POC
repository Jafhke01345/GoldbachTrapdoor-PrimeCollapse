def is_prime_miller_rabin(n, k=40):
    """
    Standard probabilistic primality test used in internet-scale protocols.
    Guarantees a number is prime with an error probability less than 4^(-k).
    """
    if n <= 1: return False
    if n <= 3: return True
    if n % 2 == 0: return False

    r, d = 0, n - 1
    while d % 2 == 0:
        r += 1
        d //= 2

    for _ in range(k):
        a = secrets.randbelow(n - 3) + 2
        x = pow(a, d, n)
        if x == 1 or x == n - 1:
            continue
        for _ in range(r - 1):
            x = pow(x, 2, n)
            if x == n - 1:
                break
        else:
            return False
    return True

def generate_large_secure_prime(bits=1024):
    """Generates a cryptographically secure large prime number on the fly via CSPRNG."""
    while True:
        # Set top two bits and bottom bit to ensure full length and odd parity
        candidate = secrets.randbits(bits) | (1 << (bits - 1)) | 1
        if is_prime_miller_rabin(candidate):
            return candidate

